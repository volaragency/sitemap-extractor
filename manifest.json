/**
 * Sitemap Extractor - Chrome Extension Manifest
 *
 * Developed by: Volar Agency
 * Website: https://thevolar.com
 *
 * Auto-discovers, extracts, and exports sitemap URLs with intelligent
 * WordPress sitemap detection and nested sitemap support.
 */

{
  "manifest_version": 3,
  "name": "Sitemap Extractor",
  "version": "3.0.0",
  "description": "Intelligent sitemap extractor with WordPress support - by Volar Agency",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
